{
  "name": "finebank-api",
  "version": "1.0.0",
  "description": "Backend REST API untuk FineBank Admin UI (Pemrograman Sisi Server)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node seeders/demo-seed.js",
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1 test/auth.test.js test/bills.test.js test/expenses.test.js test/pagination.test.js test/profiling.test.js test/stats.test.js test/migrations.test.js test/serverless.test.js",
    "import": "node scripts/import-csv.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:undo": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "supertest": "^7.3.1"
  },
  "optionalDependencies": {
    "sqlite3": "^6.0.1"
  }
}
